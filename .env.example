# Copia este archivo a .env y reemplaza TODOS los valores "change-me".
# .env nunca se commitea (ver .gitignore).

ENVIRONMENT=development

# --- PostgreSQL ---
# POSTGRES_USER es el propietario (solo migraciones). La API usa civia_app,
# un rol sin superusuario para que Row-Level Security se aplique siempre.
POSTGRES_USER=civia
POSTGRES_PASSWORD=change-me
POSTGRES_DB=civia
APP_DB_PASSWORD=change-me-app
DATABASE_URL=postgresql+asyncpg://civia_app:change-me-app@127.0.0.1:5432/civia
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://civia:change-me@127.0.0.1:5432/civia

# --- Redis ---
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@127.0.0.1:6379/0

# --- Almacenamiento S3 (MinIO en local) ---
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=civia
S3_SECRET_KEY=change-me-at-least-8
S3_BUCKET=civia-files

# --- Auth (JWT EdDSA / Ed25519) ---
# Genera con: python scripts/gen_jwt_key.py   (vacío = clave efímera solo en desarrollo)
JWT_PRIVATE_KEY_PEM=
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_SECONDS=1209600
HIBP_CHECK_ENABLED=true

# --- Clave AES-256 para secretos en reposo (semillas MFA) ---
# Genera con: python scripts/gen_data_key.py   (vacío = efímera, solo desarrollo)
DATA_ENCRYPTION_KEY=

# --- Correo (console = se escribe en el log; smtp en staging/producción) ---
EMAIL_BACKEND=console
EMAIL_FROM=CIVIA <no-reply@civia.example>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Clientes (CIVIA-FRONTEND) ---
CORS_ORIGINS=["http://localhost:3000"]
WEB_BASE_URL=http://localhost:3000
