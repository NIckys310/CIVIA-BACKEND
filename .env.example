# Copia este archivo a .env y reemplaza TODOS los valores "change-me".
# .env nunca se commitea (ver .gitignore).

ENVIRONMENT=development

# --- PostgreSQL ---
POSTGRES_USER=civia
POSTGRES_PASSWORD=change-me
POSTGRES_DB=civia
DATABASE_URL=postgresql+psycopg://civia:change-me@127.0.0.1:5432/civia

# --- Redis ---
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@127.0.0.1:6379/0

# --- Almacenamiento S3 (MinIO en local) ---
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=civia
S3_SECRET_KEY=change-me-at-least-8
S3_BUCKET=civia-files

# --- Auth ---
# Genera con: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_SECONDS=1209600

# --- CORS / web ---
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
