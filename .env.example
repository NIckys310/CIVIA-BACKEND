# Copia este archivo a .env (nunca se commitea) y ajusta los valores para producción.
# Sin .env, CIVIA arranca en modo desarrollo: H2 local, claves generadas en data/keys y motor de IA local.

# --- Servidor ---
PORT=8080
# Carpeta de la interfaz (repositorio CIVIA-FRONTEND clonado al lado)
CIVIA_WEB_DIR=../CIVIA-FRONTEND/web
CIVIA_STORAGE_DIR=./data/uploads
CIVIA_MAX_UPLOAD=2GB

# --- Base de datos (producción: activa el perfil "prod") ---
# SPRING_PROFILES_ACTIVE=prod
# DATABASE_URL=jdbc:postgresql://host:5432/civia?sslmode=require
# DATABASE_USERNAME=civia
# DATABASE_PASSWORD=change-me

# --- Seguridad (Base64 de 32+ bytes; genera con: openssl rand -base64 48) ---
CIVIA_JWT_SECRET=
CIVIA_DATA_KEY=
CIVIA_ACCESS_TOKEN_MINUTES=15
CIVIA_REFRESH_TOKEN_DAYS=30
# true en producción (HTTPS). Los navegadores aceptan cookies Secure en http://localhost.
CIVIA_SECURE_COOKIES=true
CIVIA_CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# --- Correo (recuperación de contraseña) ---
# log: el correo se escribe en el log (desarrollo). smtp: se envía con los datos SPRING_MAIL_*.
CIVIA_MAIL_MODE=log
CIVIA_MAIL_FROM=CIVIA AI <no-reply@civia.local>
# URL pública de la interfaz, usada en los enlaces de los correos
CIVIA_PUBLIC_URL=http://localhost:8080
# SPRING_MAIL_HOST=smtp.ejemplo.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# --- Contraseñas filtradas (Have I Been Pwned, k-anonymity; solo salen 5 caracteres del SHA-1) ---
CIVIA_HIBP_ENABLED=true

# --- Inteligencia artificial (opcional) ---
# Con clave, CIVIA Copilot y el análisis de planos usan Claude; sin ella, el motor local.
ANTHROPIC_API_KEY=
CIVIA_AI_MODEL=claude-opus-5-5
# Profundidad de razonamiento de Claude: low, medium, high (por defecto), xhigh o max.
CIVIA_AI_EFFORT=high
# Memoria de la conversación (turnos), longitud máxima del mensaje y preguntas por minuto por usuario.
CIVIA_AI_HISTORY_TURNS=40
CIVIA_AI_MAX_MESSAGE_CHARS=12000
CIVIA_AI_REQUESTS_PER_MINUTE=20
# Tiempo máximo de una respuesta en streaming (minutos).
CIVIA_AI_STREAM_TIMEOUT_MINUTES=5

# --- Cuenta de prueba local (solo desarrollo, se crea desde la pantalla de registro) ---
# Correo:      demo@civia.local
# Contraseña:  Planta-Libre-2026
